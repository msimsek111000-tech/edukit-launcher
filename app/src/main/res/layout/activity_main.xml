<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTimeBank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Screen Time: 0s"
        android:textColor="#00E676"
        android:textSize="24sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnOpenEduApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Open Edu Kit Apps" />

    <Button
        android:id="@+id/btnSpendTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Use Screen Time (Launcher)" />

    <Button
        android:id="@+id/btnParentMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Parent Mode (PIN)" />

    <WebView
        android:id="@+id/eduWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:visibility="gone" />

</LinearLayout>
