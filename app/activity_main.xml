<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Bar: Shows Screen-Time and Parent Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvTimeBank"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Screen Time: 0m 0s"
            android:textColor="#00E676"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnParentMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Parent Mode" />
    </LinearLayout>

    <!-- The App List where installed apps appear -->
    <ListView
        android:id="@+id/listApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
